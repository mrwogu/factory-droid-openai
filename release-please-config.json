{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "python",
  "packages": {
    ".": {
      "package-name": "factory-droid-openai",
      "include-component-in-tag": false,
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": true,
      "extra-files": [
        "src/factory_droid_openai/app.py",
        {
          "type": "json",
          "path": "openapi.json",
          "jsonpath": "$.info.version"
        },
        {
          "type": "yaml",
          "path": ".github/ISSUE_TEMPLATE/bug_report.yml",
          "jsonpath": "$.body[?(@.id=='bridge-version')].attributes.placeholder"
        },
        {
          "type": "toml",
          "path": "uv.lock",
          "jsonpath": "$.package[?(@.name.value=='factory-droid-openai')].version"
        }
      ],
      "release-as": "1.0.0"
    }
  },
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Features"
    },
    {
      "type": "fix",
      "section": "Bug Fixes"
    },
    {
      "type": "perf",
      "section": "Performance Improvements"
    },
    {
      "type": "revert",
      "section": "Reverts"
    },
    {
      "type": "chore",
      "section": "Miscellaneous",
      "hidden": true
    },
    {
      "type": "docs",
      "section": "Documentation",
      "hidden": true
    },
    {
      "type": "ci",
      "section": "Continuous Integration",
      "hidden": true
    },
    {
      "type": "build",
      "section": "Build System",
      "hidden": true
    },
    {
      "type": "refactor",
      "section": "Code Refactoring",
      "hidden": true
    },
    {
      "type": "test",
      "section": "Tests",
      "hidden": true
    },
    {
      "type": "style",
      "section": "Styles",
      "hidden": true
    }
  ],
  "pull-request-title-pattern": "chore${scope}: release ${version}",
  "include-v-in-tag": true
}
